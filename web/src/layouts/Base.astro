---
import { ClientRouter } from 'astro:transitions';
import { site } from '@/data/site';
import Board from '@/components/Board.astro';
import Corners from '@/components/Corners.astro';
import Reticle from '@/components/Reticle.astro';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  page: 'home' | 'unit' | 'transcript' | 'missing';
  unit?: string;
}
const { title, description = site.description, page, unit } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og.png', Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'AccessibilityApplication',
  operatingSystem: 'Android, iOS',
  description: site.description,
  url: site.url,
  codeRepository: site.repo,
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const hasSheet = page !== 'home';
---
<!doctype html>
<html lang="en" transition:animate="none" class:list={[hasSheet && 'has-sheet']} data-page={page} data-unit={unit}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eceff0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/hand-300_800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/voice-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Corners />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Board />
    <Reticle />
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <script>
      import { start } from '@/engine/astro';
      import { setupMotion } from '@/motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
