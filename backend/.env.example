# Google Gemini API key (required)
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini model to use (optional, defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Audio amplitude multiplier for playback gain (optional, defaults to 0.1)
# Lower keeps audio from overpowering the glasses' speakers
AUDIO_AMPLITUDE_MULTIPLIER=0.1

# Azure Speech subscription key and resource region (required for TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Speech voice (optional)
# AZURE_SPEECH_VOICE=en-US-GuyNeural
